# Go build output
/dist/
/clamav-webui
/clamav-webui.exe
*.test
*.out

# internal/webui/dist holds the built SPA that gets go:embed-ed. Only .gitkeep
# is tracked -- enough for `//go:embed all:dist` to compile before a frontend
# build has run. The real index.html + assets/ are Vite build artifacts with
# hashed names; committing them would leave the tree dirty every build.
/internal/webui/dist/*
!/internal/webui/dist/.gitkeep

# Frontend
/web/node_modules/
/web/.vite/
/web/coverage/
/web/dist/

# Local state / editor
/.devstate/
*.db
*.db-shm
*.db-wal
.DS_Store
Thumbs.db
.idea/
.vscode/
*.log
